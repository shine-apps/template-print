# 依赖与构建
node_modules/
dist/
out/
# 仅忽略根目录打包产物；scripts/release、tests/release 是源码目录
/release/

# 脑暴可视化伴侣本地产物
.superpowers/

# Trae IDE 本地技能/记忆/工具（不纳入版本控制）
.trae/

# 原生 ABI 切换脚本缓存
.native-bin/

# 本地数据库与资源
*.db
*.db-journal
# 仅忽略项目根目录的 assets/（运行时用户数据在 %APPDATA%，不会出现在仓库），
# 但 src/renderer/assets/ 等源码内资源目录需要纳入版本控制
/assets/
thumbs/

# 环境与日志
.env
.env.local
*.log
