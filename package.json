{
  "name": "template-print",
  "version": "0.2.0",
  "private": true,
  "description": "可视化模板设计与打印桌面程序",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "rebuild": "electron-builder install-app-deps",
    "dist": "powershell -ExecutionPolicy Bypass -File ./scripts/dist.ps1",
    "gen:icon": "node scripts/gen-icon.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "adm-zip": "^0.5.18",
    "antd": "^5.21.0",
    "better-sqlite3": "^13.0.3",
    "dayjs": "^1.11.13",
    "drizzle-orm": "^0.33.0",
    "konva": "^9.3.16",
    "nanoid": "^3.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "react-router-dom": "^6.26.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.9.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.5.4",
    "vite": "^7.3.6",
    "vitest": "^2.1.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
